# Swarm Controller project marker
# This file causes swarm-controller to auto-discover this project on startup.
# The project will appear in the dashboard but agents will NOT be assigned work
# unless you explicitly enable it via the dashboard or set managed: true here.
#
# Set managed: true only after you understand the bootstrapping risk:
# agents editing this router will modify the LLM backend they depend on.

name: shrimp-router
type: python
managed: false
