# MiniMax (primary LLM provider)
MINIMAX_API_KEY=sk-cp-...

# Kimi (optional, direct Kimi API)
KIMI_API_KEY=sk-kimi-...

# OpenCode Go service (https://opencode.ai)
# Used for plan/scout phases via Kimi K2.6 and DeepSeek V4 Flash
OPENCODE_API_KEY=sk-...
# Required alias — headroom's anyllm/openai backend reads OPENAI_API_KEY
OPENAI_API_KEY=sk-...  # set to the same value as OPENCODE_API_KEY

# Web search (optional — DDG fallback is always available)
BRAVE_API_KEY=...
TAVILY_API_KEY=tvly-...
